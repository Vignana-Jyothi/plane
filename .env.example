# Database Settings
POSTGRES_USER="plane"
POSTGRES_PASSWORD="plane"
POSTGRES_DB="plane"
PGDATA="/var/lib/postgresql/data"

# Redis Settings
REDIS_HOST="plane-redis"
REDIS_PORT="6379"

# RabbitMQ Settings
RABBITMQ_HOST="plane-mq"
RABBITMQ_PORT="5672"
RABBITMQ_USER="plane"
RABBITMQ_PASSWORD="plane"
RABBITMQ_VHOST="plane"

LISTEN_HTTP_PORT=80
LISTEN_HTTPS_PORT=443

# AWS Settings
AWS_REGION=""
AWS_ACCESS_KEY_ID="access-key"
AWS_SECRET_ACCESS_KEY="secret-key"
AWS_S3_ENDPOINT_URL="http://plane-minio:9000"
# Changing this requires change in the proxy config for uploads if using minio setup
AWS_S3_BUCKET_NAME="uploads"
# Maximum file upload limit - 20MB. Was 5MB, which is easy for a real cover
# image or pitch deck to exceed (a plain phone photo commonly does), causing
# uploads to fail with no clear error client-side.
FILE_SIZE_LIMIT=20971520

# GPT settings
OPENAI_API_BASE="https://api.openai.com/v1" # deprecated
OPENAI_API_KEY="sk-" # deprecated
GPT_ENGINE="gpt-3.5-turbo" # deprecated

# Settings related to Docker
DOCKERIZED=1  # deprecated

# set to 1 If using the pre-configured minio setup
USE_MINIO=1

# If SSL Cert to be generated, set CERT_EMAIl="email <EMAIL_ADDRESS>"
CERT_ACME_CA=https://acme-v02.api.letsencrypt.org/directory
TRUSTED_PROXIES=0.0.0.0/0
SITE_ADDRESS=:80
CERT_EMAIL=

# For DNS Challenge based certificate generation, set the CERT_ACME_DNS, CERT_EMAIL
# CERT_ACME_DNS="acme_dns <CERT_DNS_PROVIDER> <CERT_DNS_PROVIDER_API_KEY>"
CERT_ACME_DNS=

# Force HTTPS for handling SSL Termination
MINIO_ENDPOINT_SSL=0

# API key rate limit
API_KEY_RATE_LIMIT="60/minute"

# VJ Startups: connection to the public site's backend (vjstartups-main-website),
# used by the admin panel's Ecosystem Ideas/Problems/Users audit screens.
# Base URL of that backend's API (its PORT is 6220 by default in its own .env.example).
# NEXT_PUBLIC_MICROSERVICE_URL is accepted as a legacy fallback name for this
# same value if VJ_MICROSERVICE_URL isn't set - prefer setting this one.
VJ_MICROSERVICE_URL=http://localhost:6220

# Shared secret used in BOTH directions between this Django instance and
# vjstartups-main-website's backend, over the X-Internal-Token header:
#   - Django -> backend 2: the admin panel's Ecosystem Ideas/Problems/Users
#     screens, and startup-stage sync, forward the real acting admin's
#     identity via X-Acting-Admin-Email, authenticated by this token (see
#     AdminMicroserviceProxyBase.get_headers() in
#     apps/api/plane/vj_startups/views/admin.py). Without this set correctly,
#     those screens fail every request and show "Authorization token
#     required" rather than data - if they look empty/erroring, check this
#     first.
#   - backend 2 -> Django: the public site's own backend uses this same value
#     to call Django's internal user-upsert endpoint
#     (public-auth/upsert-user/) when someone logs in there.
# Must match PLANE_INTERNAL_TOKEN in vjstartups-main-website's backend/.env
# exactly. Never expose this to a browser - it's server-to-server only.
PUBLIC_SITE_INTERNAL_TOKEN=

# Deprecated 2026-09-21 - do not set. The admin proxy above now uses
# PUBLIC_SITE_INTERNAL_TOKEN + X-Acting-Admin-Email instead of one static
# admin's personal bearer token. Kept here only so old deployments don't
# error on an unrecognized key; backend 2's adminAuth.js/verifierAuth.js
# still accept a personal Bearer <publicAdminToken> as a fallback for any
# future direct (non-proxied) frontend use, but this specific env var is
# unused.
VJ_MICROSERVICE_ADMIN_TOKEN=
