{
  "name": "plane",
  "version": "1.3.1",
  "private": true,
  "description": "Open-source project management that unlocks customer value",
  "license": "AGPL-3.0",
  "repository": "https://github.com/makeplane/plane.git",
  "scripts": {
    "setup": "node scripts/setup.js",
    "build": "turbo run build",
    "dev": "turbo run dev --concurrency=18",
    "start": "pnpm run docker:start && pnpm dev",
    "clean": "turbo run clean",
    "fix": "turbo run fix",
    "fix:format": "turbo run fix:format",
    "fix:lint": "turbo run fix:lint",
    "check": "turbo run check",
    "check:lint": "turbo run check:lint",
    "check:format": "turbo run check:format",
    "check:types": "turbo run check:types",
    "docker:start": "docker compose -f docker-compose-local.yml up -d",
    "docker:stop": "docker compose -f docker-compose-local.yml down",
    "docker:restart": "docker compose -f docker-compose-local.yml down && docker compose -f docker-compose-local.yml up -d",
    "seed": "docker compose -f docker-compose-local.yml exec api python manage.py seed_vj_startups",
    "test-api": "docker compose -f docker-compose-test.yml up --build --abort-on-container-exit --exit-code-from api-tests",
    "test-api-teardown": "docker compose -f docker-compose-test.yml down -v",
    "prepare": "husky"
  },
  "devDependencies": {
    "husky": "catalog:",
    "lint-staged": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "turbo": "catalog:"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,cjs,mjs,cts,mts,json,css,md}": [
      "pnpm exec oxfmt --no-error-on-unmatched-pattern"
    ],
    "*.{js,jsx,ts,tsx,cjs,mjs,cts,mts}": [
      "pnpm exec oxlint --fix --deny-warnings"
    ]
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "packageManager": "pnpm@11.3.0+sha512.2c403d6594527287672b1f7056343a1f7c3634036a67ffabfcc2b3d7595d843768f8787148d1b57cf7956c90606bbd192857c363af19e96d2d0ec9ec5741d215"
}
